  "grammar": {
    "form": "SECTION:task",
    "section": "UPPERCASE 3-letter phase — one of the seven families",
    "task": "lowercase [a-z0-9-], ≤14 chars, hyphens allowed",
    "rule": "Extend codes, not storage. A new fact is a new code in the ontology jsonb, never a new table.",
    "phaseDerivation": "phase = code.split(':')[0] — the prefix IS the phase; an unknown prefix falls through to LUP"
  },
  "evidenceLadder": {
    "$comment": "VcSource → confidence bar. sensed sits below measured on purpose: an instrument that snapped to the neighbour is worse than the homeowner's own tape.",
